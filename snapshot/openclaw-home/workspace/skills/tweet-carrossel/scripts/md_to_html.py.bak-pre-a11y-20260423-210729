    transition: border-color 0.2s;
  }}
  .modal textarea:focus {{ border-color: #c9a24e; outline: none; }}
  .modal-actions {{ display: flex; gap: 10px; justify-content: flex-end; margin-top: 18px; }}
  .btn-cancel {{ background: #ddd; color: #333; }}
  .btn-cancel:hover {{ background: #bbb; }}
  .btn-send {{ background: #1a1a1a; color: #fff; }}
  .btn-send:hover {{ background: #2a2a2a; }}
  .modal-status {{ margin-top: 12px; padding: 10px; border-radius: 4px; font-size: 14px; display: none; }}
  .modal-status.success {{ background: #d4edda; color: #1a7a3a; display: block; }}
  .modal-status.error {{ background: #f8d7da; color: #721c24; display: block; }}

  footer {{ text-align: center; padding: 30px; color: #888; font-size: 12px; border-top: 1px solid #e5e5e5; margin-top: 40px; }}
  footer a {{ color: #8b6914; }}

  @media print {{
    header.top, .validator {{ display: none; }}
    main {{ box-shadow: none; max-width: 100%; padding: 0 20px; }}
  }}
  @media (max-width: 640px) {{
    main {{ padding: 24px 18px; }}
    h1 {{ font-size: 24px; }}
    h2 {{ font-size: 19px; }}
    h3 {{ font-size: 16.5px; }}
    p, li {{ font-size: 15px; }}
    table {{ font-size: 13px; }}
    th, td {{ padding: 8px 10px; }}
    .validator-buttons {{ flex-direction: column; }}
    .btn {{ width: 100%; }}
  }}
</style>
</head>
<body>
<header class="top">
  <h1>
    <span>🩺 Instituto Vital Slim — Entrega de conteúdo</span>
    <span class="badge" id="status-badge">AGUARDANDO VALIDAÇÃO</span>
  </h1>
</header>
<main>
  <div class="validator">
    <h2>📋 Documento para sua aprovação</h2>
    <p><strong>{title}</strong></p>
    <p>Revise o conteúdo abaixo. Escolha uma ação:</p>
    <div class="validator-buttons">
      <button class="btn btn-approve" onclick="openModal('APROVO')">✓ APROVO — pode seguir</button>
      <button class="btn btn-adjust" onclick="openModal('AJUSTAR')">↻ AJUSTAR</button>
      <button class="btn btn-reject" onclick="openModal('REJEITAR')">✗ REJEITAR</button>
    </div>
  </div>

{body}

  <footer>
    Gerado automaticamente pelo pipeline de conteúdo do IVS • Fonte canônica: <a href="https://github.com/institutovitalslim/cerebro-vital-slim">GitHub cerebro-vital-slim</a>
  </footer>
</main>

<!-- MODAL DE FEEDBACK -->
<div class="modal-overlay" id="feedback-modal">
  <div class="modal">
    <h3 id="modal-title">Enviar feedback</h3>
    <p id="modal-subtitle">Descreva o que vc quer ajustar ou deixe em branco pra só confirmar.</p>
    <textarea id="feedback-text" placeholder="Ex: ajustar script 5.1 pra tom mais empático; trocar hashtags do tema hormonal..."></textarea>
    <div class="modal-actions">
      <button class="btn btn-cancel" onclick="closeModal()">Cancelar</button>
      <button class="btn btn-send" onclick="submitFeedback()" id="send-btn">Enviar</button>
    </div>
    <div class="modal-status" id="modal-status"></div>
  </div>
</div>

<script>
  const docName = window.location.pathname.split('/').pop() || 'unknown';
  let currentAction = null;
  function openModal(action) {{
    currentAction = action;
    document.getElementById('modal-title').textContent = action === 'APROVO' ? 'Aprovar entrega' : action === 'AJUSTAR' ? 'O que ajustar?' : 'Por que rejeitar?';
    document.getElementById('modal-subtitle').textContent = action === 'APROVO'
      ? 'Clica em Enviar pra confirmar a aprovacao. Pode adicionar uma nota se quiser.'
      : action === 'AJUSTAR'
      ? 'Descreve em texto o que vc quer ajustar. Quanto mais especifico, melhor.'
      : 'Me conta o motivo pra eu refazer do zero no caminho certo.';
    document.getElementById('feedback-text').value = '';
    document.getElementById('modal-status').className = 'modal-status';
    document.getElementById('modal-status').textContent = '';
    document.getElementById('feedback-modal').classList.add('show');
    setTimeout(() => document.getElementById('feedback-text').focus(), 100);
  }}
  function closeModal() {{
    document.getElementById('feedback-modal').classList.remove('show');
  }}
  async function submitFeedback() {{
    const text = document.getElementById('feedback-text').value.trim();
    const btn = document.getElementById('send-btn');
    const status = document.getElementById('modal-status');
    btn.disabled = true;
    btn.textContent = 'Enviando...';
    try {{
      const res = await fetch('/feedback', {{
        method: 'POST',
        headers: {{ 'Content-Type': 'application/json' }},
        body: JSON.stringify({{ doc: docName, action: currentAction, text: text, ts: new Date().toISOString() }}),
      }});
      if (res.ok) {{
        status.className = 'modal-status success';
        status.textContent = '✓ Feedback enviado! Vou processar e retornar.';
        document.getElementById('status-badge').textContent = currentAction + ' RECEBIDO';
        document.getElementById('status-badge').style.background = currentAction === 'APROVO' ? '#2a8a4a' : currentAction === 'AJUSTAR' ? '#c9a24e' : '#a64a4a';
        document.getElementById('status-badge').style.color = currentAction === 'AJUSTAR' ? '#1a1a1a' : '#fff';
        setTimeout(closeModal, 1800);
      }} else {{
        status.className = 'modal-status error';
        status.textContent = '✗ Erro ao enviar (HTTP ' + res.status + '). Tenta de novo.';
      }}
    }} catch (e) {{
      status.className = 'modal-status error';
      status.textContent = '✗ Erro de rede. Tenta de novo.';
    }} finally {{
      btn.disabled = false;
      btn.textContent = 'Enviar';
    }}
  }}
  // Close modal on Escape or click outside
  document.addEventListener('keydown', e => {{ if (e.key === 'Escape') closeModal(); }});
  document.getElementById('feedback-modal').addEventListener('click', e => {{
    if (e.target.id === 'feedback-modal') closeModal();
  }});
</script>
</body>
</html>
"""


def convert(md_path: Path, html_path: Path, title: str):
    md_text = md_path.read_text(encoding="utf-8")
    html_body = markdown.markdown(
        md_text,
        extensions=["tables", "fenced_code", "toc", "sane_lists", "nl2br", "attr_list"],
        output_format="html5",
    )
    indented = "\n".join("  " + line for line in html_body.splitlines())
    final_html = TEMPLATE.format(title=title, body=indented)
    html_path.write_text(final_html, encoding="utf-8")
    print(f"ok: {html_path} ({len(final_html)} chars)")


if __name__ == "__main__":
    if len(sys.argv) < 4:
        print("uso: md_to_html.py <entrada.md> <saida.html> <titulo>", file=sys.stderr)
        sys.exit(1)
    convert(Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3])
