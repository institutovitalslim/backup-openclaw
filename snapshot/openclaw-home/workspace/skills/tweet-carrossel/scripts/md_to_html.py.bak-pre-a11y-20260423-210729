    min-height: 100vh;
    box-shadow: 0 0 40px rgba(0,0,0,0.04);
  }}
  h1 {{ font-size: 30px; font-weight: 700; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 2px solid #c9a24e; line-height: 1.25; }}
  h2 {{ font-size: 22px; font-weight: 700; margin-top: 40px; margin-bottom: 16px; line-height: 1.3; }}
  h3 {{ font-size: 18px; font-weight: 600; color: #2a2a2a; margin-top: 28px; margin-bottom: 12px; padding-left: 10px; border-left: 3px solid #c9a24e; }}
  h4 {{ font-size: 15px; font-weight: 600; color: #4a4a4a; margin-top: 18px; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.6px; }}
  p {{ margin-bottom: 14px; color: #2a2a2a; font-size: 15.5px; }}
  ul, ol {{ margin-left: 24px; margin-bottom: 16px; }}
