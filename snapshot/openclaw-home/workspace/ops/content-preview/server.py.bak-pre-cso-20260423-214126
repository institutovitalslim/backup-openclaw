def process_feedback_async(entry: dict):
    """Dispatch the feedback to the OpenClaw agent for auto-processing."""
    def worker():
        try:
            doc = entry.get("doc", "")
            action = entry.get("action", "")
            text = entry.get("text", "")
            ts = entry.get("ts", "")

            # Build the user message for the agent
            user_msg = (
                f"FEEDBACK AUTOMATICO RECEBIDO\n"
                f"Documento: {doc}\n"
                f"Ação: {action}\n"
                f"Texto do feedback:\n{text}\n\n"
                f"Aplique o protocolo."
            )

            session_key = f"feedback-autoproc-{doc}-{int(time.time())}"

            payload = {
                "model": "openclaw/main",
                "input": user_msg,
                "user": f"content-validator",
                "instructions": AUTO_PROCESS_INSTRUCTIONS,
            }
            headers = {
                "Authorization": f"Bearer {OPENCLAW_GATEWAY_TOKEN}",
                "Content-Type": "application/json",
                "x-openclaw-session-key": session_key,
            }
            req = urllib.request.Request(
                OPENCLAW_GATEWAY_URL,
                data=json.dumps(payload).encode(),
                headers=headers,
                method="POST",
            )
            print(f"[autoproc] dispatching feedback to agent: doc={doc} action={action}", flush=True)
            with urllib.request.urlopen(req, timeout=600) as r:
                data = json.loads(r.read().decode())

            # Extract reply text
            texts = []
            for item in data.get("output") or []:
                for part in item.get("content") or []:
                    if isinstance(part, dict) and part.get("type") == "output_text" and isinstance(part.get("text"), str):
                        texts.append(part["text"])
            reply = "\n".join(t.strip() for t in texts if t and t.strip()).strip()

            # If APROVO: trigger next profile from queue
            if action == "APROVO":
                try:
                    import subprocess
                    from datetime import datetime, timezone
                    # Mark current as approved in queue (if it maps)
                    import json as _json
                    queue_path = "/root/.openclaw/workspace/ops/content-preview/queue/content-queue.json"
                    try:
                        with open(queue_path) as qf:
                            qdata = _json.load(qf)
                        doc_base = doc.replace(".html", "").replace("-producao", "")
                        for prof in qdata.get("profiles", []):
                            if prof.get("doc") == doc_base or ("analise-perfil-" + prof.get("username","") in doc_base):
                                prof["status"] = "approved"
                                prof["approved_at"] = datetime.now(timezone.utc).isoformat()
                                break
                        qdata["updated_at"] = datetime.now(timezone.utc).isoformat()
                        with open(queue_path, "w") as qf:
                            _json.dump(qdata, qf, indent=2, ensure_ascii=False)
                        log("[queue] marked as approved in queue")
                    except Exception as e:
                        log(f"[queue] mark approved failed: {e}")
                    # Spawn subagent in background to process next profile
                    subprocess.Popen(
                        ["/usr/bin/python3", "/root/.openclaw/workspace/ops/content-preview/profile_analyzer.py"],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        start_new_session=True,
                    )
                    log("[queue] triggered subagent for next profile")
                except Exception as e:
                    log(f"[queue] trigger failed: {e}")

            if reply:
                send_telegram(f"🤖 <b>Processamento automático concluído</b>\n<b>Doc:</b> {doc}\n\n{reply[:2500]}")
                print(f"[autoproc] done: {reply[:200]}", flush=True)
            else:
                send_telegram(f"⚠️ <b>Processamento automático retornou vazio</b>\n<b>Doc:</b> {doc}\n<b>Ação:</b> {action}\nProvavelmente falha — revise manualmente.")
        except Exception as e:
            err = str(e)[:400]
            print(f"[autoproc] error: {err}", flush=True)
            send_telegram(f"❌ <b>Falha no processamento automático</b>\n<b>Doc:</b> {entry.get('doc','?')}\n<b>Erro:</b> {err}")

    threading.Thread(target=worker, daemon=True).start()


class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body, content_type="text/html; charset=utf-8"):
        body_bytes = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body_bytes)))
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body_bytes)

    def _file(self, path: Path):
        if not path.exists() or not path.is_file():
            self._send(404, f"<h1>404</h1><p>{path.name} nao encontrado</p>")
            return
        data = path.read_bytes()
        ct = "text/html; charset=utf-8" if path.suffix == ".html" else (
            "text/markdown; charset=utf-8" if path.suffix == ".md" else "text/plain; charset=utf-8"
        )
        self._send(200, data, ct)

    def do_HEAD(self):
        self.do_GET()

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()

    def do_GET(self):
        url = self.path.split("?")[0]
        if url in ("/", "/index.html"):
            self._file(BASE_DIR / "index.html")
            return
        if url == "/api/list":
            files = []
            for f in sorted(CONTENT_DIR.glob("*.html")):
                st = f.stat()
                files.append({
                    "name": f.name,
                    "size": st.st_size,
                    "mtime": time.strftime("%Y-%m-%d %H:%M", time.localtime(st.st_mtime)),
                })
            self._send(200, json.dumps(files), "application/json; charset=utf-8")
            return
        if url == "/api/feedbacks":
            feedbacks = []
            if FEEDBACK_LOG.exists():
                for line in FEEDBACK_LOG.read_text(encoding="utf-8").splitlines():
                    try:
                        feedbacks.append(json.loads(line))
                    except Exception:
                        pass
            self._send(200, json.dumps(feedbacks[-50:]), "application/json; charset=utf-8")
            return
        if url.startswith("/conteudo/"):
            rel = url[len("/conteudo/"):]
            if ".." in rel or rel.startswith("/"):
                self._send(403, "forbidden")
                return
            self._file(CONTENT_DIR / rel)
            return
        self._send(404, "<h1>404</h1>")

    def do_POST(self):
        if self.path != "/feedback":
            self._send(404, "not found")
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
            raw = self.rfile.read(length).decode("utf-8")
            data = json.loads(raw) if raw else {}
            doc = str(data.get("doc", "unknown"))[:200]
            action = str(data.get("action", "UNKNOWN"))[:20]
            text = str(data.get("text", ""))[:3000]
            ts = str(data.get("ts", time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())))
            entry = {"ts": ts, "doc": doc, "action": action, "text": text,
                     "ip": self.client_address[0]}
            with open(FEEDBACK_LOG, "a", encoding="utf-8") as f:
                f.write(json.dumps(entry, ensure_ascii=False) + "\n")

            # Notify Marketing topic first (fast, visible)
            emoji = {"APROVO": "✅", "AJUSTAR": "🔄", "REJEITAR": "❌"}.get(action, "📋")
            notify_body = (
                f"{emoji} <b>Feedback recebido</b>\n"
                f"<b>Doc:</b> {doc}\n"
                f"<b>Ação:</b> {action}"
            )
            if text:
                notify_body += f"\n\n<b>Nota:</b>\n{text[:1500]}"
            notify_body += f"\n\n⏳ Processamento automático iniciado..."
            send_telegram(notify_body)

            # Kick off auto-processing (runs in background thread)
            process_feedback_async(entry)

            self._send(200, json.dumps({"ok": True, "autoprocess": "started"}), "application/json; charset=utf-8")
        except Exception as e:
            self._send(500, json.dumps({"ok": False, "error": str(e)}), "application/json; charset=utf-8")

    def log_message(self, fmt, *args):
        print(f"[{time.strftime('%H:%M:%S')}] {self.address_string()} {fmt%args}", flush=True)


